{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "test-results", "playwright-report", ".auth"]
}
