{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "target": "es2024",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "preserveSymlinks": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@shared/*": ["../shared/src/*"]
    },
    "lib": ["es2024", "dom"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts"
  ],
  "references": [{ "path": "../shared" }]
}
