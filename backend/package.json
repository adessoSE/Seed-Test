{
  "name": "seed-test-backend",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "start": "tsc -b && node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test-coverage": "vitest run --coverage",
    "test-watch": "vitest",
    "database": "tsc -b && node --env-file-if-exists=.env dist/database/installDatabase.js",
    "database-examples": "tsc -b && node --env-file-if-exists=.env dist/database/insertExampleData.js",
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('./dist',{recursive:true,force:true})\"",
    "tsc": "tsc -b",
    "lint": "eslint src/",
    "exec-test": "./node_modules/.bin/cucumber-js",
    "postinstall": "npx playwright install --with-deps"
  },
  "private": true,
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@seed-test/shared": "*",
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "cucumber-html-reporter": "^7.2.0",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "selenium-webdriver": "^4.52.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/adm-zip": "^0.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "testcontainers": "^12.2.1",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "_comment": "Bitte bei cucumber-html-reporter > 7.2.0 wieder entfernen!",
  "overrides": {
    "cucumber-html-reporter": {
      "semver": "^7.5.2"
    }
  }
}
