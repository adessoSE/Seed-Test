{
  "name": "seed-test-backend",
  "version": "1.8.1",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "start": "tsc -b && node dist/server.js",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-watch": "vitest",
    "database": "tsc -b && node dist/database/installDatabase.js",
    "database-examples": "tsc -b && node dist/database/insertExampleData.js",
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('./dist',{recursive:true,force:true})\"",
    "tsc": "tsc -b",
    "lint": "eslint src/",
    "exec-test": "./node_modules/.bin/cucumber-js",
    "postinstall": "npx playwright install --with-deps"
  },
  "private": true,
  "dependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.62.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "geckodriver": "^6.1.1",
    "helmet": "^8.3.0",
    "moment": "^2.30.1",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "playwright": "^1.62.0",
    "selenium-webdriver": "^4.46.0",
    "tar": "^7.5.22",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "_comment": "Bitte bei cucumber-html-reporter > 7.2.0 wieder entfernen!",
  "overrides": {
    "cucumber-html-reporter": {
      "semver": "^7.5.2"
    }
  }
}
