{
  "name": "seed-test-backend",
  "version": "1.8.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "start": "tsc -b && node dist/server.js",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-watch": "vitest",
    "database": "tsc -b && node dist/database/installDatabase.js",
    "database-examples": "tsc -b && node dist/database/insertExampleData.js",
    "clean": "rimraf ./dist",
    "tsc": "tsc -b",
    "lint": "eslint src/",
    "exec-test": "./node_modules/.bin/cucumber-js",
    "postinstall": "npx playwright install --with-deps"
  },
  "private": true,
  "dependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.1",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-flash": "0.0.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.2",
    "geckodriver": "^6.0.1",
    "helmet": "^8.3.0",
    "moment": "^2.30.1",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "playwright": "^1.55.1",
    "selenium-webdriver": "^4.35.0",
    "stream-to-string": "^1.2.1",
    "string-to-stream": "^3.0.1",
    "tar": "^7.5.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/express-session": "^1.18.2",
    "@types/handlebars": "^4.0.40",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.17",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@vitest/coverage-v8": "^4.0.5",
    "eslint": "^10.7.0",
    "rimraf": "^6.0.1",
    "typescript": ">=5.9.0 <6.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.5"
  },
  "_comment": "Bitte bei cucumber-html-reporter > 7.2.0 wieder entfernen!",
  "overrides": {
    "cucumber-html-reporter": {
      "semver": "^7.5.2"
    }
  }
}
