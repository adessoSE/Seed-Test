# Environment variables for the backend. Copy to backend/.env (gitignored).
# Validated at startup by backend/src/config.ts; a missing or invalid value stops the server with a list of all problems.
# Optional variables are commented out on purpose: an empty line sets the variable to "" and overrides the default.

# --- Required ---

# MongoDB connection string, e.g. mongodb://<user>:<password>@localhost:27017.
# The local docker compose default is in docker-compose.yml (service backend, DATABASE_URI); copy it from there, do not commit real credentials.
DATABASE_URI=

# 64-character hex string for AES-256-GCM encryption of stored secrets (backend/src/helpers/cryptoHelper.ts).
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# Jira integration: values used to encrypt sensitive Jira data. Use long random values.
JIRA_SECRET=
# Salt for the same encryption. At least 16 random bytes.
JIRA_SALT=

# --- Optional (defaults in backend/src/config.ts) ---

# Express session secret (express-session). Plain string, not a list.
# Required unless NODE_ENV=development or NODE_ENV=test; without it in development, each start uses a random secret and logs everyone out.
# SESSION_SECRET=change-me-to-a-long-random-string

# Explicit development opt-in: SESSION_SECRET becomes optional. Unset NODE_ENV counts as production for SESSION_SECRET.
# NODE_ENV=development

# Backend port. Default: 8080
# PORT=8080

# Frontend origin for CORS and password-reset links. Default: http://localhost:4200
# FRONTEND_URL=http://localhost:4200

# SameSite policy of the session cookie: lax | strict | none. Default: lax
# COOKIE_SAMESITE=lax

# Secure flag of the session cookie: true | false. Default: true only when NODE_ENV=production.
# Set false only for plain-HTTP setups (the local docker compose files do).
# COOKIE_SECURE=false

# Express trust proxy (first hop): true | false. Default: true only when NODE_ENV=production.
# Set false when the backend port is reachable without a reverse proxy, or clients can spoof X-Forwarded-For.
# TRUST_PROXY=false

# Number of reports kept before older ones are removed (backend/src/services/report.service.ts). Default: 10
# MAX_SAVED_REPORTS=10

# Minutes after which a test report is deleted. Default: 5
# REPORT_DELETION_TIME=5

# GitHub OAuth app. Both are needed for GitHub login; without them GitHub-dependent endpoints return 501.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Mail account for password-reset mails (backend/src/nodemailer.ts).
# EMAIL_AUTH=
# EMAIL_PW=
# EMAIL_HOST=
# EMAIL_PORT=

# GitHub test account used by the repository-creation shortcut (backend/src/controllers/repository.controller.ts).
# TESTACCOUNT_REPO=
# TESTACCOUNT_NAME=
# TESTACCOUNT_TOKEN=
