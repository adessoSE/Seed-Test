# Backend API base URL served to the app by frontend/server.js. Default: http://localhost:8080/api
API_SERVER=

# GitHub OAuth client ID used by the frontend. Use the same value as GITHUB_CLIENT_ID in backend/.env.
GITHUB_CLIENT_ID=

# Port of the frontend server (frontend/server.js). Default: 4200
# PORT=4200

# Test-runner browsers offered in the UI (frontend/server.js).
# Defaults: CHROMIUM_ENABLED=true, GECKO_ENABLED=false, EDGE_ENABLED=false, WEBKIT_ENABLED=false
# CHROMIUM_ENABLED=true
# GECKO_ENABLED=false
# EDGE_ENABLED=false
# WEBKIT_ENABLED=false

# Set to any value to disable the demo-version warning.
# VERSION=
