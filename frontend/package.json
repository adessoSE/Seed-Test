{
  "name": "seed-test-frontend",
  "version": "1.8.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run build & node server.js",
    "build": "ng build --configuration production",
    "test": "jest --verbose",
    "test-watch": "jest --watch",
    "test-coverage": "jest --coverage",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand",
    "lint": "ng lint",
    "prod": "ng serve -c production",
    "dev": "ng serve & node server.js",
    "compodoc": "./node_modules/.bin/compodoc -p tsconfig.json -w -s"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.6",
    "@angular/cdk": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/common": "^20.1.6",
    "@angular/compiler": "^20.1.6",
    "@angular/core": "^20.1.6",
    "@angular/forms": "^20.1.6",
    "@angular/localize": "^20.1.6",
    "@angular/material": "^20.1.5",
    "@angular/platform-browser": "^20.1.6",
    "@angular/platform-browser-dynamic": "^20.1.6",
    "@angular/router": "^20.1.6",
    "@material/checkbox": "^15.0.0-canary.fff4066c6.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ngneat/until-destroy": "^10.0.0",
    "canvg": "^4.0.3",
    "core-js": "^3.45.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "hammerjs": "^2.0.8",
    "html2canvas": "1.4.1",
    "jest-preset-angular": "^14.6.0",
    "jquery": "^3.7.1",
    "jspdf": "^3.0.1",
    "ngx-cookie-service": "^20.1.0",
    "ngx-logger": "~5.0.12",
    "ngx-owl-carousel-o": "^20.0.0",
    "ngx-toastr": "19.0.0",
    "rxjs": "^6.5.3 || ^7.4.0",
    "uikit": "^3.23.11",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.1.1",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "20.1.1",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/build": "^20.1.5",
    "@angular/compiler-cli": "^20.1.6",
    "@compodoc/compodoc": "^1.1.26",
    "@popperjs/core": "^2.11.8",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "tslib": "^2.8.1",
    "typescript": ">=5.5.0 <5.9.0"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setup.jest.ts",
      "jest-canvas-mock"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/dist/"
    ],
    "coveragePathIgnorePatterns": [
      ".html"
    ],
    "ts-jest": {
      "tsconfig": "<rootDir>/tsconfig.spec.json",
      "stringifyContentPathRegex": "\\.html$"
    },
    "globals": {}
  }
}
