# Template for the root .env, read by docker-compose.yml, docker-local.yml and docker-test.yml.
# Copy to .env and replace every value. .env is gitignored; never commit it.

# Encryption key for stored credentials. Exactly 64 hex characters, e.g. from `openssl rand -hex 32`.
ENCRYPTION_SECRET=change-me

# Root user of the MongoDB container. Use only URL-safe characters: @ : / ? # % break DATABASE_URI.
MONGO_ROOT_USERNAME=change-me
MONGO_ROOT_PASSWORD=change-me

# Session signing secret. Required because the backend image runs with NODE_ENV=production.
SESSION_SECRET=change-me

# Jira integration: key material for encrypting users' Jira credentials.
JIRA_SECRET=change-me
JIRA_SALT=change-me
