# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
/frontend/dist

# dependencies
/frontend/node_modules
/backend/node_modules
/node_modules

# IDEs and editors
.idea/workspace.xml
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
frontend/.idea
backend/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Documentation styling (tracked despite this rule; delete the rule or `git rm --cached` if unwanted)
frontend/src/assets/documentation/styles/site.css

# environment variables: secrets must never be tracked
# Covers .env, .env.local, .env.production, .env.<anything>; templates stay tracked
.env
.env.*
!.env.example
!.env.*.example
*.local
# Tracked environment modules (version/env only, no secrets); rules kept as a no-op marker
frontend/src/environments/environment.ts
environment.prod.ts

# System files
.DS_Store
Thumbs.db

# Lints
tslint.json

# Coverage & code analysis
frontend/src/coverage/
sonar-project.properties
.scannerwork
frontend/documentation
frontend/coverage
frontend/.angular/
.angular/
.nyc_output/

# Cucumber & reports
**/*.feature
backend/features/reporting_*.json
backend/features/reporting_html*.html
test-results/
playwright-report/

# Batches for install, update and start (no tracked files match today; scripts/ would need a negation)
*.bat
*.sh
*.ps1

# Website deployment with IIS
**/web.config
/website

# logs
logs/
backend/logs/

# local testing for step-definition development
backend/features/step_definitions/testing.js

/act
mongo-rs/rs_keyfile
backend/tsconfig.tsbuildinfo
*.tsbuildinfo
opencode.jsonc

# Agent tooling: only project-specific config is tracked; installed/third-party skills stay local
CLAUDE.local.md
**/CLAUDE.local.md
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
.claude/skills/*
!.claude/skills/seed-review/
**/.agents/
frontend/.claude/
backend/.claude/
shared/.claude/
e2e/.claude/
skills-lock.json

# Agent working files (local tracking only, never committed)
workers/
tasks/
**/VORGEHENSWEISE.md

# Ephemeral artifacts from Playwright E2E testing and debugging
# Screenshots are ignored everywhere except tracked app/doc assets
*.png
*.PNG
!frontend/src/assets/**/*.png
!frontend/src/assets/**/*.PNG
*.mjs
!**/eslint.config.mjs
*.log
*.log.*
cookies.txt
frontend-test*.txt
backend-err.log

# Ephemeral agent test-output logs (ensure these are never tracked)
frontend/ng-test-output.txt
frontend/test-output.txt
frontend/vitest-output.txt

# Editor and merge leftovers
*.orig
*.bak
*.rej
*.swp
*~

# Database dumps
dbbackups/
*.bson
*.dump

# Ephemeral agent tooling data (indexes, traces, browser panel state)
.codebase-memory/
.openchamber/
*.openchamber.backup
.playwright-mcp/

# Playwright E2E session and test account (never commit)
e2e/.auth/
